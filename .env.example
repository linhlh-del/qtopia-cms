# Supabase dùng chung (cms-supabase) — chỉ anon key, KHÔNG dùng service role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Website QTOPIA (mặc định https://qtopia.rever.io.vn)
VITE_SITE_URL=
# Tuỳ chọn — mặc định ${VITE_SITE_URL}/cms-schema.json và ${VITE_SITE_URL}/cms-status.json
VITE_SCHEMA_URL=
VITE_STATUS_URL=
# Chỉ dùng khi `npm run dev` tại máy: 1 = đăng nhập demo, nháp lưu localStorage, schema đọc public/cms-schema.json
# VITE_CMS_DEMO=1
